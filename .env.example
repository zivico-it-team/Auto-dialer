# ===================================================
# Call Center SIP Auto-Dialer Platform Environment Config
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MySQL / PostgreSQL / SQLite)
# Example MySQL: mysql://username:password@localhost:3306/call_center_db
DATABASE_URL="file:./dev.db"

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Telephony Configuration
# Provider: 'mock' (for local development & testing) or 'asterisk' (for real PBX)
TELEPHONY_PROVIDER=mock

# Asterisk AMI (Asterisk Manager Interface) Credentials
ASTERISK_HOST=127.0.0.1
ASTERISK_PORT=5038
ASTERISK_USERNAME=admin
ASTERISK_PASSWORD=your_asterisk_ami_password
ASTERISK_CALL_CONTEXT=from-internal
ASTERISK_OUTBOUND_TRUNK=SIP/trunk_provider

# SIP Server / Softphone Domain
SIP_DOMAIN=127.0.0.1
SIP_PORT=5060

# Secure Call Recordings Storage
RECORDING_STORAGE_PATH=./recordings
RECORDING_ENABLED_DEFAULT=true

# Dialer Safety & Concurrency Defaults
GLOBAL_MAX_CONCURRENT_CALLS=10
DEFAULT_CALLING_START_TIME="09:00"
DEFAULT_CALLING_END_TIME="18:00"
DEFAULT_TIMEZONE="America/New_York"
