PORT=5000
NODE_ENV=development
FRONTEND_URLS=http://localhost:5173,https://talk.talkingwave.tech
DATABASE_URL="mysql://root:1234@localhost:3306/talkingwave_dialer"
JWT_SECRET=super_secret_jwt_key_callcenter_autodialer_2026
JWT_EXPIRES_IN=7d



# Use mock until the Hostinger server has network access to the PBX AMI port.
TELEPHONY_PROVIDER=impactpbx
ASTERISK_HOST=talkingwave.impactpbx.com
ASTERISK_PORT=5038
ASTERISK_USERNAME=admin
ASTERISK_PASSWORD=Aakkeel@1021
ASTERISK_CALL_CONTEXT=from-internal
ASTERISK_OUTBOUND_TRUNK=SIP/talkingwave_trunk
ASTERISK_OUTBOUND_PREFIX=+
SIP_DOMAIN=talkingwave.impactpbx.com
SIP_PORT=5060
RECORDING_STORAGE_PATH=./recordings
RECORDING_ENABLED_DEFAULT=true
GLOBAL_MAX_CONCURRENT_CALLS=10
DEFAULT_CALLING_START_TIME="09:00"
DEFAULT_CALLING_END_TIME="22:00"
DEFAULT_TIMEZONE="Asia/Colombo"
TZ="Asia/Colombo"