# Hostinger production (copy to backend/.env on the server, then fill the DB values)
# Hostinger normally injects PORT. Keep this only if its Node.js panel asks for it.
# PORT is supplied by Hostinger in production.
NODE_ENV=production
FRONTEND_URLS=https://talk.talkingwave.tech
DATABASE_URL="mysql://HOSTINGER_DB_USER:URL_ENCODED_DB_PASSWORD@localhost:3306/HOSTINGER_DB_NAME"
JWT_SECRET=replace_with_a_unique_long_random_secret
JWT_EXPIRES_IN=7d

# Use mock until the Hostinger server has network access to the PBX AMI port.
TELEPHONY_PROVIDER=mock
ASTERISK_HOST=talkingwave.impactpbx.com
ASTERISK_PORT=5038
ASTERISK_USERNAME=admin
ASTERISK_PASSWORD=replace_with_asterisk_ami_password
ASTERISK_CALL_CONTEXT=from-internal
ASTERISK_OUTBOUND_TRUNK=SIP/talkingwave_trunk
SIP_DOMAIN=talkingwave.impactpbx.com
SIP_PORT=5060
RECORDING_STORAGE_PATH=./recordings
RECORDING_ENABLED_DEFAULT=true
GLOBAL_MAX_CONCURRENT_CALLS=10
DEFAULT_CALLING_START_TIME="09:00"
DEFAULT_CALLING_END_TIME="18:00"
DEFAULT_TIMEZONE="America/New_York"
